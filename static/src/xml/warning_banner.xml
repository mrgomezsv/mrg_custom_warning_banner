<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrg_custom_warning_banner.WarningBanner">
        <div class="o_warning_banner_container">
            <div t-if="this.state.enabled"
                 class="o_warning_banner_systray"
                 role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <span t-out="this.state.warningText"/>
            </div>
        </div>
    </t>
</templates>