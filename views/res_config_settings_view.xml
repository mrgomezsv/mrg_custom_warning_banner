<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_warning_banner" model="ir.ui.view">
        <field name="name">res.config.settings.warning.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='app_settings_block'][last()]" position="after">
                <div class="app_settings_block" data-string="Banner de Advertencia" data-key="custom_warning_banner">
                    <h2>⚠️ Banner de Advertencia</h2>
                    
                    <!-- Primera fila: Checkbox para activar/desactivar -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_warning_banner"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_warning_banner" class="fw-bold">Mostrar Banner de Advertencia</label>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-info-circle me-1"></i>
                                    Activa esta opción para mostrar un banner de advertencia en la parte superior de todas las páginas del sistema.
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Segunda fila: Campo de texto -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="warning_banner_text" 
                                       placeholder="⚠️ FACTURA PENDIENTE DE PAGO"
                                       style="width: 100%; min-width: 500px; max-width: 800px;"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="warning_banner_text" class="fw-bold">Texto del Banner</label>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-edit me-1"></i>
                                    Personaliza el mensaje que se mostrará en el banner de advertencia.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>