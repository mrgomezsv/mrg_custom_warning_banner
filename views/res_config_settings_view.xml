<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_warning_banner" model="ir.ui.view">
        <field name="name">res.config.settings.warning.banner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'settings')]" position="inside">
                <div class="app_settings_block" data-string="Banner de Advertencia" data-key="custom_warning_banner">
                    <h2>⚠️ Banner de Advertencia</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_warning_banner"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_warning_banner">Mostrar Banner de Advertencia</label>
                                <div class="text-muted">
                                    Activa esta opción para mostrar un banner de advertencia en la parte superior de todas las páginas
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="warning_banner_text"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="warning_banner_text">Texto del Banner</label>
                                <div class="text-muted">
                                    Texto que se mostrará en el banner de advertencia
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>